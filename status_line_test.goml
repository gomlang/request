package request;

use std::testing;

#[test]
fn http_status_line_checks_full_grammar_and_accepts_empty_or_opaque_reason() -> () {
    for line in["HTTP/1.1 200 ", "HTTP/1.0 200 OK", "HTTP/1.1 200 \tOK", "HTTP/1.1 200 Résultat"] {
        testing::assert_eq(testing::expect_ok(http1_status_line(line), "valid status").1, 200);
    }
    for line in[
        "",
        "HTTP/1.1 200",
        "HTTP/1.2 200 OK",
        "HTTP/1.1  200 OK",
        "HTTP/1.1 20 OK",
        "HTTP/1.1 2000 OK",
        "HTTP/1.1 099 OK",
        "HTTP/1.1 600 OK",
        "HTTP/1.1 abc OK",
        "HTTP/1.1 200 OK\u0000",
        "HTTP/1.1 200 OK\r",
        "HTTP/1.1 200 OK\n",
        "HTTP/1.1 200 OK\u007f",
    ] {
        testing::assert_err(http1_status_line(line));
    }
}
