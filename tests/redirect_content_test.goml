package tests;

use ecosystem::request::{Client};
use std::bytes::{Bytes};
use std::io;
use std::net;
use std::task;
use std::testing;
use std::time::{Duration};

fn redirect_content_case(status: isize, method: string, api: string, rewritten: bool) -> () {
    let listener = testing::expect_ok(
        net::TcpListener::bind(net::SocketAddr::new(net::IpAddr::V4([127, 0, 0, 1]), 0)),
        "redirect listener",
    );
    defer {
        let _ = listener.close();
    };
    let origin = "http://" + testing::expect_ok(listener.local_addr(), "address").to_string();
    let observed: Channel[(string, string)] = Channel::new(2);
    let payload = if method == "HEAD" {
        ""
    } else {
        "body"
    };
    let sha = if method == "HEAD" {
        "47DEQpj8HBSa+/TImW+5JCeuQeRkm5NMpJWZG3hSuFU="
    } else {
        "Iw2DWNyOiJC0xY3utikS7i8gNXrpKlzIYbmOaP4xrLU="
    };
    let md5 = if method == "HEAD" {
        "1B2M2Y8AsgTpgAmY7PhCfg=="
    } else {
        "hBotaJrYa9FhFEdFPCLG/A=="
    };
    let fields = Vec::from_array(
        [
            ("content-type", "application/octet-stream"),
            ("content-encoding", "identity"),
            ("content-language", "en"),
            ("content-location", "/source"),
            ("content-range", "bytes 0-3/4"),
            ("last-modified", "Mon, 05 Oct 2026 00:00:00 GMT"),
            ("content-digest", "sha-256=:" + sha + ":"),
            ("repr-digest", "sha-256=:" + sha + ":"),
            ("digest", "sha-256=" + sha),
            ("content-md5", md5),
        ],
    );
    let wait = net::WaitOptions::new().with_timeout(Duration::from_seconds(3));
    task::scope(
        |scope| {
            let _ = scope.spawn(
                |_| {
                    for index in 0..2 {
                        let (socket, _) = testing::expect_ok(listener.accept_with(wait), "accept");
                        defer {
                            let _ = socket.close();
                        };
                        let input = Bytes::new();
                        let byte = Vec::from_array([0]);
                        loop {
                            testing::assert_ok(socket.read_exact_with(byte.as_mut_slice(), wait));
                            input.push(byte[0]);
                            testing::assert(input.len() < 16384);
                            if input.len() >= 4
                                && input.slice(input.len() - 4, input.len()).to_vec() == b"\r\n\r\n" {
                                break
                            }
                        }
                        let head = string_from_utf8(input.to_vec()).1;
                        let body = if head.to_ascii_lowercase().contains("content-length: 4\r\n") {
                            let bytes = Vec::from_array([0, 0, 0, 0]);
                            testing::assert_ok(socket.read_exact_with(bytes.as_mut_slice(), wait));
                            string_from_utf8(bytes).1
                        } else {
                            ""
                        };
                        observed.send((head, body));
                        let response = if index == 0 {
                            "HTTP/1.1 " + status.to_string()
                                + " Redirect\r\nLocation: /target\r\nContent-Length: 0\r\nConnection: close\r\n\r\n"
                        } else {
                            "HTTP/1.1 200 OK\r\nContent-Length: 0\r\nConnection: close\r\n\r\n"
                        };
                        testing::assert_ok(
                            socket.write_all_with(response.to_bytes().as_slice(), wait),
                        );
                    }
                },
            );
            let client = testing::expect_ok(Client::new(), "client");
            defer client.close();
            let mut request = client.request(method, origin + "/source").timeout(
                Duration::from_seconds(3),
            );
            for (name, value) in fields {
                request = request.header(name, value);
            }
            request = request.header("accept-language", "fr").header("x-end", "retained");
            let result = if api == "reader" {
                request.send_reader(
                    io::StringReader::new(payload),
                    Option::Some(payload.byte_len()),
                    streaming_text,
                )
            } else if api == "stream" {
                request.body(Bytes::from_string(payload)).send_stream(streaming_text)
            } else {
                request.body(Bytes::from_string(payload)).send().and_then(
                    |response| response.text(),
                )
            };
            testing::assert_eq(testing::expect_ok(result, "redirect response"), "");
        },
    );
    let (initial, initial_body) = testing::expect_some(observed.recv(), "initial request");
    let (redirected, redirected_body) = testing::expect_some(observed.recv(), "redirected request");
    testing::assert_eq(initial_body, payload);
    testing::assert_eq(
        redirected_body,
        if rewritten {
            ""
        } else {
            payload
        },
    );
    testing::assert(
        redirected.starts_with(
            if rewritten {
                "GET /target "
            } else {
                method + " /target "
            },
        ),
    );
    testing::assert(redirected.contains("accept-language: fr\r\n"));
    testing::assert(redirected.contains("x-end: retained\r\n"));
    let stale = Vec::new();
    for (name, value) in fields {
        let line = name + ": " + value + "\r\n";
        testing::assert(initial.contains(line));
        if rewritten {
            if redirected.contains(line) {
                stale.push(name);
            }
        } else {
            testing::assert(redirected.contains(line));
        }
    }
    testing::assert_eq(stale.join(","), "");
}

#[test]
fn redirect_content_fields_are_removed_from_rewritten_buffered_requests() -> () {
    for (status, method) in[(301, "POST"), (302, "POST"), (303, "PUT"), (303, "GET")] {
        redirect_content_case(status, method, "buffered", true);
    }
}

#[test]
fn redirect_content_fields_are_removed_from_rewritten_streamed_requests() -> () {
    for (status, method) in[(301, "POST"), (302, "POST"), (303, "PUT"), (303, "GET")] {
        redirect_content_case(status, method, "stream", true);
    }
}

#[test]
fn redirect_content_fields_are_removed_after_a_streaming_upload() -> () {
    for (status, method) in[(301, "POST"), (302, "POST"), (303, "PUT")] {
        redirect_content_case(status, method, "reader", true);
    }
}

#[test]
fn redirect_content_fields_survive_when_the_original_request_is_replayed() -> () {
    for api in["buffered", "stream"] {
        for (status, method) in[
            (307, "POST"),
            (308, "POST"),
            (301, "GET"),
            (302, "PUT"),
            (303, "HEAD"),
        ] {
            redirect_content_case(status, method, api, false);
        }
    }
}
