package tests;

use ecosystem::request::{Client, Url};
use std::bytes::{Bytes};
use std::net;
use std::task;
use std::testing;
use std::time::{Duration};

#[test]
fn reference_join_preserves_inherited_paths_without_new_path_segments() -> () {
    let base = testing::expect_ok(Url::parse("https://example.com/a/./b/../c%2fd?old"), "base");
    for (reference, expected) in[
        ("", "https://example.com/a/./b/../c%2fd?old"),
        ("#fragment", "https://example.com/a/./b/../c%2fd?old"),
        ("?", "https://example.com/a/./b/../c%2fd?"),
        ("?new=../x", "https://example.com/a/./b/../c%2fd?new=../x"),
    ] {
        testing::assert_eq(testing::expect_ok(base.join(reference), "join").as_string(), expected);
    }
}

#[test]
fn reference_join_removes_dot_segments_from_absolute_and_network_references() -> () {
    let base = testing::expect_ok(Url::parse("https://base.test/a/b?old"), "base");
    for (reference, expected) in[
        ("http://other.test/x/../y?x=/../z", "http://other.test/y?x=/../z"),
        ("//other.test/x/./y/..", "https://other.test/x/"),
        ("https://other.test/a//b/../%2e/%2f", "https://other.test/a//%2e/%2f"),
    ] {
        testing::assert_eq(testing::expect_ok(base.join(reference), "join").as_string(), expected);
    }
}

fn reference_redirect_target(reference: string, initial: string, expected: string) -> () {
    for streaming in[false, true] {
        let listener = testing::expect_ok(
            net::TcpListener::bind(net::SocketAddr::new(net::IpAddr::V4([127, 0, 0, 1]), 0)),
            "listener",
        );
        let origin = "http://" + testing::expect_ok(listener.local_addr(), "address").to_string();
        let observed = Channel::new(2);
        let wait = net::WaitOptions::new().with_timeout(Duration::from_seconds(2));
        task::scope(
            |scope| {
                defer {
                    let _ = listener.close();
                };
                let _ = scope.spawn(
                    |_| {
                        for index in 0..2 {
                            let (socket, _) = testing::expect_ok(
                                listener.accept_with(wait),
                                "accept",
                            );
                            defer {
                                let _ = socket.close();
                            };
                            let input = Bytes::new();
                            let byte = Vec::from_array([0]);
                            loop {
                                testing::assert_ok(
                                    socket.read_exact_with(byte.as_mut_slice(), wait),
                                );
                                input.push(byte[0]);
                                if input.len() >= 4
                                    && input.slice(input.len() - 4, input.len()).to_vec()
                                        == b"\r\n\r\n" {
                                    break
                                }
                            }
                            observed.send(
                                testing::expect_some(
                                    string_from_utf8(input.to_vec()).1.split_once("\r\n"),
                                    "request line",
                                ).0,
                            );
                            let response = if index == 0 {
                                "HTTP/1.1 302 Found\r\nLocation: " + reference
                                    + "\r\nContent-Length: 0\r\nConnection: close\r\n\r\n"
                            } else {
                                "HTTP/1.1 200 OK\r\nContent-Length: 2\r\nConnection: close\r\n\r\nok"
                            };
                            testing::assert_ok(
                                socket.write_all_with(response.to_bytes().as_slice(), wait),
                            );
                        }
                    },
                );
                let client = testing::expect_ok(Client::new(), "client");
                defer client.close();
                let request = client.get(origin + initial).timeout(Duration::from_seconds(2));
                let result = if streaming {
                    request.send_stream(|response| streaming_text(response))
                } else {
                    request.send().and_then(|response| response.text())
                };
                testing::assert_eq(testing::expect_ok(result, "redirect response"), "ok");
            },
        );
        testing::assert_eq(
            testing::expect_some(observed.recv(), "initial request"),
            "GET " + initial + " HTTP/1.1",
        );
        testing::assert_eq(
            testing::expect_some(observed.recv(), "redirected request"),
            "GET " + expected + " HTTP/1.1",
        );
    }
}

#[test]
fn reference_join_query_redirect_preserves_the_requested_path_over_tcp() -> () {
    reference_redirect_target("?new=1", "/a/./b/../c%2fd?old", "/a/./b/../c%2fd?new=1");
}

#[test]
fn reference_join_dot_segments_keep_empty_segments_above_the_root() -> () {
    let base = testing::expect_ok(Url::parse("http://example.com/base/file"), "base");
    for (reference, expected) in[
        ("/..//target?next=/../x", "http://example.com//target?next=/../x"),
        ("../..//target", "http://example.com//target"),
        ("/a/../../..///target", "http://example.com///target"),
        ("http://other.test/..//target", "http://other.test//target"),
        ("//other.test/..//target", "http://other.test//target"),
    ] {
        testing::assert_eq(testing::expect_ok(base.join(reference), "join").as_string(), expected);
    }
}

#[test]
fn reference_join_final_dot_segments_keep_adjacent_empty_segments() -> () {
    let base = testing::expect_ok(Url::parse("http://example.com/base/file"), "base");
    for (reference, expected) in[
        ("/a//.", "http://example.com/a//"),
        ("/a///..", "http://example.com/a//"),
        ("/a//.?next=/../x", "http://example.com/a//?next=/../x"),
        ("http://other.test/a///..", "http://other.test/a//"),
        ("//other.test/a//.", "http://other.test/a//"),
        ("/a/%2e//.", "http://example.com/a/%2e//"),
        ("/a/..", "http://example.com/"),
        ("/../.", "http://example.com/"),
    ] {
        testing::assert_eq(testing::expect_ok(base.join(reference), "join").as_string(), expected);
    }
}

#[test]
fn reference_join_redirect_keeps_empty_path_segments_over_tcp() -> () {
    reference_redirect_target("/a//.", "/initial", "/a//");
    reference_redirect_target("/..//target", "/initial", "//target");
}
