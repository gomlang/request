package tests;

use ecosystem::request::{Client, ErrorKind, Url};
use std::testing;

#[test]
fn url_authority_rejects_invalid_registered_names_and_ip_literals() -> () {
    let base = testing::expect_ok(Url::parse("https://example.com/base"), "base");
    let accepted: Vec[string] = Vec::new();
    for authority in[
        "bad<host",
        "bad>host",
        "bad^host",
        "bad|host",
        "bad{host",
        "bad}host",
        "bad\"host",
        "bad`host",
        "[127.0.0.1]",
        "[127.0.0.1]:8080",
    ] {
        if Url::parse("http://" + authority + "/").is_ok() {
            accepted.push(authority);
        }
        if base.join("//" + authority + "/").is_ok() {
            accepted.push("relative:" + authority);
        }
    }
    testing::assert_eq(accepted.join(","), "");
}

#[test]
fn url_authority_preserves_valid_hosts_and_port_spelling() -> () {
    for (input, expected) in[
        ("http://Example.COM:/", "http://example.com:/"),
        ("http://127.0.0.1:00080/", "http://127.0.0.1:00080/"),
        ("https://[2001:DB8::1]:00443/", "https://[2001:db8::1]:00443/"),
        ("http://[::ffff:127.0.0.1]/", "http://[::ffff:127.0.0.1]/"),
        ("http://café.example/", "http://café.example/"),
        ("http://a!$&'()*+,;=._~-z/", "http://a!$&'()*+,;=._~-z/"),
    ] {
        testing::assert_eq(
            testing::expect_ok(Url::parse(input), "valid host").as_string(),
            expected,
        );
    }
}

#[test]
fn url_authority_validation_applies_to_request_and_proxy_builders() -> () {
    let client = testing::expect_ok(Client::new(), "client");
    defer client.close();
    for value in["http://bad<host/", "http://[127.0.0.1]:8080/"] {
        testing::assert_eq(
            testing::expect_err(client.get(value).build(), "invalid request authority").kind,
            ErrorKind::Builder,
        );
        testing::assert_eq(
            testing::expect_err(Client::builder().proxy(value).build(), "invalid proxy authority").kind,
            ErrorKind::Builder,
        );
    }
}

#[test]
fn url_authority_rejects_bracketed_ipv4_before_sending() -> () {
    let server = start(false, false);
    defer close(server);
    let client = testing::expect_ok(Client::builder().no_proxy().build(), "client");
    defer client.close();
    let invalid = url(server).replace("127.0.0.1", "[127.0.0.1]");
    testing::assert_eq(
        testing::expect_err(client.get(invalid).send(), "invalid host reached the TCP server").kind,
        ErrorKind::Builder,
    );
    testing::assert_eq(
        testing::expect_err(
            client.get(invalid).send_stream(|response| streaming_text(response)),
            "invalid streaming host reached the TCP server",
        ).kind,
        ErrorKind::Builder,
    );
    testing::assert_eq(
        testing::expect_ok(
            client.get(url(server)).send().and_then(|response| response.text()),
            "valid IPv4 request",
        ),
        "ok",
    );
}
