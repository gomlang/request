package cookies;

fn decimal(value: string) -> Option[isize] {
    if value == "" {
        return Option::None
    }
    let mut result: isize = 0;
    for byte in value.to_bytes() {
        if byte < b'0' || byte > b'9'
            || result > (9223372036854775807 - (byte - b'0').to_isize()) / 10 {
            return Option::None
        }
        result = result * 10 + (byte - b'0').to_isize();
    }
    Option::Some(result)
}

fn date_delimiter(value: byte) -> bool {
    value == 9 || value >= 32 && value <= 47 || value >= 59 && value <= 64
        || value >= 91 && value <= 96
        || value >= 123 && value <= 126
}

fn date_number(value: string, minimum: isize, maximum: isize) -> Option[isize] {
    let mut end = 0;
    while end < value.byte_len() && value.byte_get(end) >= b'0' && value.byte_get(end) <= b'9' {
        end += 1;
    }
    if end < minimum || end > maximum {
        return Option::None
    }
    decimal(value.byte_slice(0, end))
}

fn date_clock(value: string) -> Option[(isize, isize, isize)] {
    let (hour, remainder) = value.split_once(":")?;
    let (minute, second) = remainder.split_once(":")?;
    if hour.byte_len() > 2 || minute.byte_len() > 2 {
        return Option::None
    }
    Option::Some((decimal(hour)?, decimal(minute)?, date_number(second, 1, 2)?))
}

pub fn cookie_date(value: string) -> Option[i64] {
    let mut day = Option::None;
    let mut month = Option::None;
    let mut year = Option::None;
    let mut clock = Option::None;
    let months = Vec::from_array(
        ["jan", "feb", "mar", "apr", "may", "jun", "jul", "aug", "sep", "oct", "nov", "dec"],
    );
    let mut cursor = 0;
    while cursor < value.byte_len() {
        if date_delimiter(value.byte_get(cursor)) {
            cursor += 1;
            continue
        }
        let start = cursor;
        while cursor < value.byte_len() && !date_delimiter(value.byte_get(cursor)) {
            cursor += 1;
        }
        let token = value.byte_slice(start, cursor);
        // RFC 6265 section 5.1.1 gives time, day, month, then year priority.
        // Each component is taken from its first matching token.
        if clock.is_none() {
            if let Some(parsed) = date_clock(token) {
                clock = Option::Some(parsed);
                continue
            }
        }
        if day.is_none() {
            if let Some(parsed) = date_number(token, 1, 2) {
                day = Option::Some(parsed);
                continue
            }
        }
        if month.is_none() {
            let name = lower_ascii(token);
            for index in 0..months.len() {
                if name.starts_with(months[index]) {
                    month = Option::Some(index + 1);
                    break
                }
            }
            if month.is_some() {
                continue
            }
        }
        if year.is_none() {
            year = date_number(token, 2, 4);
        }
    }
    let day = day?;
    let month = month?;
    let mut year = year?;
    let (hour, minute, second) = clock?;
    if year < 70 {
        year += 2000;
    } else if year < 100 {
        year += 1900;
    }
    if year < 1601 || day < 1 || day > 31 {
        return Option::None
    }
    if hour > 23 || minute > 59 || second > 59 {
        return Option::None
    }
    let leap = year % 4 == 0 && (year % 100 != 0 || year % 400 == 0);
    let lengths = Vec::from_array(
        [
            31,
            if leap {
                29
            } else {
                28
            },
            31,
            30,
            31,
            30,
            31,
            31,
            30,
            31,
            30,
            31,
        ],
    );
    if day > lengths[month - 1] {
        return Option::None
    }
    let prior = year - 1;
    let mut days = (year - 1970) * 365 + prior / 4 - prior / 100 + prior / 400
        - (1969 / 4 - 1969 / 100 + 1969 / 400);
    for index in 0..month - 1 {
        days += lengths[index];
    }
    days += day - 1;
    Option::Some((days * 86400 + hour * 3600 + minute * 60 + second).to_i64())
}
